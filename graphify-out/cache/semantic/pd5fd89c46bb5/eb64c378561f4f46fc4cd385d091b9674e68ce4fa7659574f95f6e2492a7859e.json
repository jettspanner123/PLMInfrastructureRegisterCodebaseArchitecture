{"nodes": [{"id": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_strong_typing", "label": "Strong Typing Policy", "file_type": "concept", "source_file": "PLMInfrastructureRegisterOrchestratorServiceLayerMSC/CODING-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Prohibits `dynamic`/untyped `object` and `var` where an explicit type is possible; code must compile without nullable-reference warnings."}, {"id": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_naming_suffix_table", "label": "Type-Specific Naming Suffixes", "file_type": "concept", "source_file": "PLMInfrastructureRegisterOrchestratorServiceLayerMSC/CODING-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "PascalCase types/classes must carry an architectural suffix (Controller, Service, Assertion, Middleware, DTO, Record, Type, CON, Utility, Helper, Validator, Exception)."}, {"id": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_abbreviations_policy", "label": "Backend Abbreviations Policy", "file_type": "concept", "source_file": "PLMInfrastructureRegisterOrchestratorServiceLayerMSC/CODING-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Same full-word-over-abbreviation rule as the frontend, allow-listing EN, IP, DNS, URL, SMTP, OS, VM, DBA, SLA, CET, SXI plus CPU, RAM, GB."}, {"id": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_asynchronous_suffix_rule", "label": "Asynchronous Method Suffix Rule", "file_type": "concept", "source_file": "PLMInfrastructureRegisterOrchestratorServiceLayerMSC/CODING-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Async methods must use the full `Asynchronous` suffix (e.g. GetUserAsynchronous), never the abbreviated `Async`."}, {"id": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_fields_parameters_naming", "label": "Fields & Parameters Naming", "file_type": "concept", "source_file": "PLMInfrastructureRegisterOrchestratorServiceLayerMSC/CODING-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Private fields use _camelCase, parameters and locals use camelCase, properties use PascalCase."}, {"id": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_feature_architecture", "label": "Feature Architecture", "file_type": "concept", "source_file": "PLMInfrastructureRegisterOrchestratorServiceLayerMSC/CODING-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Each business feature gets a standardized Features/${FeatureName}/ folder with its own Controller, Services, Assertion, Constants, Models, Utilities."}, {"id": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_feature_models", "label": "Feature Models Rule", "file_type": "concept", "source_file": "PLMInfrastructureRegisterOrchestratorServiceLayerMSC/CODING-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "All feature-specific enums/structs/interfaces/records/classes/DTOs live under Features/${FeatureName}/Models/, while behavioral classes stay in their architectural folders."}, {"id": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_global_components", "label": "Global Components Structure", "file_type": "concept", "source_file": "PLMInfrastructureRegisterOrchestratorServiceLayerMSC/CODING-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Code used across multiple features, or explicitly app-wide, moves to global Service/Constants/Models/Utilities/Middlewares/Helpers/Exceptions/Validators folders."}, {"id": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_singleton_rules", "label": "Backend Singleton Rules", "file_type": "concept", "source_file": "PLMInfrastructureRegisterOrchestratorServiceLayerMSC/CODING-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Singletons must be stateless and safe app-wide, never hold request- or user-specific mutable state; DbContext and Controllers must never be Singleton."}, {"id": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_dependency_injection_rules", "label": "Dependency Injection Rules", "file_type": "concept", "source_file": "PLMInfrastructureRegisterOrchestratorServiceLayerMSC/CODING-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Dependencies must be constructor-injected; controllers/services must not manually `new` other application services."}, {"id": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_global_helpers_singleton", "label": "Global Helpers Singleton Pattern", "file_type": "concept", "source_file": "PLMInfrastructureRegisterOrchestratorServiceLayerMSC/CODING-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "All global helper classes follow a sealed class plus private static readonly `_current`/public `Current` singleton pattern."}, {"id": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_validators_pattern", "label": "Validators Pattern", "file_type": "concept", "source_file": "PLMInfrastructureRegisterOrchestratorServiceLayerMSC/CODING-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Validators are Singletons exposing a single public `bool Validate(...)` method performing exactly one type of validation."}, {"id": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_assertion_pattern", "label": "Assertion Pattern", "file_type": "concept", "source_file": "PLMInfrastructureRegisterOrchestratorServiceLayerMSC/CODING-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Every feature needing request validation has a Singleton Features/${FeatureName}/Assertion/${FeatureName}Assertion.cs class that controllers call instead of duplicating null checks."}, {"id": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_controllers_rules", "label": "Controller Rules", "file_type": "concept", "source_file": "PLMInfrastructureRegisterOrchestratorServiceLayerMSC/CODING-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Controllers call the feature service, validate via Assertion, return `APIResponse<T>`, use try-catch, and never contain business logic or touch persistence entities directly."}, {"id": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_api_response_rules", "label": "APIResponse Naming & Structure Rules", "file_type": "concept", "source_file": "PLMInfrastructureRegisterOrchestratorServiceLayerMSC/CODING-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "The response wrapper must be named exactly `APIResponse`/`APIResponse<T>`, never `ApiResponse` variants, with consistent success/error structure and no internal detail leakage."}, {"id": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_api_endpoint_rules", "label": "API Endpoint Naming Rules", "file_type": "concept", "source_file": "PLMInfrastructureRegisterOrchestratorServiceLayerMSC/CODING-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Every endpoint must start with `/Api/V1` and use complete PascalCase segments, never abbreviations, kebab-case, snake_case, or camelCase."}, {"id": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_route_factory", "label": "Route Factory Pattern", "file_type": "concept", "source_file": "PLMInfrastructureRegisterOrchestratorServiceLayerMSC/CODING-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Route strings must never be hardcoded in controllers; all routes are declared as PascalCase constants in Factories/ApplicationRouteFactory.cs."}, {"id": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_json_property_naming", "label": "JSON Property PascalCase Rule", "file_type": "concept", "source_file": "PLMInfrastructureRegisterOrchestratorServiceLayerMSC/CODING-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "All API JSON property names, and the C# response model properties producing them, must use PascalCase, enforced app-wide in serialization config."}, {"id": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_exception_handling_rules", "label": "Exception Handling & Status Code Mapping", "file_type": "concept", "source_file": "PLMInfrastructureRegisterOrchestratorServiceLayerMSC/CODING-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Known exceptions map to specific HTTP status codes (Validation to 400, Unauthorized to 401, etc.); unexpected exceptions never leak `ex.Message` to clients."}, {"id": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_logging_rules", "label": "Structured Logging Rules", "file_type": "concept", "source_file": "PLMInfrastructureRegisterOrchestratorServiceLayerMSC/CODING-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Logging must use structured message templates, never string interpolation, and must never log passwords, tokens, API keys, or connection strings."}, {"id": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_dto_entity_separation", "label": "DTO and Entity Separation", "file_type": "concept", "source_file": "PLMInfrastructureRegisterOrchestratorServiceLayerMSC/CODING-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Controllers accept/return DTOs only; persistence entities are never exposed through API endpoints, with mapping occurring outside the controller."}, {"id": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_database_rules", "label": "Database Rules", "file_type": "concept", "source_file": "PLMInfrastructureRegisterOrchestratorServiceLayerMSC/CODING-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Async-only DB operations, no manual DbContext instantiation or Singleton registration, parameterized queries, and every table named via entity.ToTable using the IG_{Name}TBL template."}, {"id": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_async_programming_rules", "label": "Asynchronous Programming Rules", "file_type": "concept", "source_file": "PLMInfrastructureRegisterOrchestratorServiceLayerMSC/CODING-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "I/O-bound work must be async, never `.Result`/`.Wait()` or `Task.Run()` as a substitute, and CancellationToken must propagate."}, {"id": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_security_rules", "label": "Backend Security Rules", "file_type": "concept", "source_file": "PLMInfrastructureRegisterOrchestratorServiceLayerMSC/CODING-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Never hardcode or log secrets, never return raw exception details, never disable TLS validation, and never trust client-provided identity/role claims."}, {"id": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_ai_agent_repository_rules", "label": "AI Agent Repository Inspection Rules", "file_type": "concept", "source_file": "PLMInfrastructureRegisterOrchestratorServiceLayerMSC/CODING-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Before coding, the agent must inspect the relevant feature directory, existing implementations, DI registrations, and routes, then make the smallest necessary change."}, {"id": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_no_hallucination_rules", "label": "No-Hallucination Rules", "file_type": "rationale", "source_file": "PLMInfrastructureRegisterOrchestratorServiceLayerMSC/CODING-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "The agent must never invent classes, methods, endpoints, packages, or other project facts; missing information must be asked about, not guessed.", "rationale": "A plausible assumption must never be presented as an established project fact."}, {"id": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_existing_code_source_of_truth", "label": "Existing Code Is the Source of Truth", "file_type": "rationale", "source_file": "PLMInfrastructureRegisterOrchestratorServiceLayerMSC/CODING-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "The existing repository architecture and implementation is treated as the primary source of truth over personal preference.", "rationale": "Preserve existing behavior unless the task explicitly requires behavior changes; do not rewrite functioning code merely to match personal preferences."}, {"id": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_dependencies_rules", "label": "Dependency Introduction Rules", "file_type": "concept", "source_file": "PLMInfrastructureRegisterOrchestratorServiceLayerMSC/CODING-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "No new NuGet package, version upgrade, or external service dependency without explicit approval."}, {"id": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_minimal_change_rule", "label": "Minimal-Change Rule", "file_type": "rationale", "source_file": "PLMInfrastructureRegisterOrchestratorServiceLayerMSC/CODING-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Change only what the task requires; no unrelated refactors, renames, moves, or opportunistic cleanup until explicitly instructed otherwise.", "rationale": "If a required change exposes an architectural problem outside the task, report it rather than silently expanding the scope."}, {"id": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_file_modification_rules", "label": "File Modification Rules", "file_type": "concept", "source_file": "PLMInfrastructureRegisterOrchestratorServiceLayerMSC/CODING-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Files may only be renamed, moved, or deleted when the task explicitly requires it, with all references updated and the project reverified."}, {"id": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_testing_rules", "label": "Testing Rules", "file_type": "concept", "source_file": "PLMInfrastructureRegisterOrchestratorServiceLayerMSC/CODING-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "New business logic needs tests following the existing test architecture; tests must verify behavior, not just increase coverage."}, {"id": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_build_verification_rules", "label": "Build and Verification Rules", "file_type": "rationale", "source_file": "PLMInfrastructureRegisterOrchestratorServiceLayerMSC/CODING-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "The agent must never claim build/test success without actually performing verification, and must explicitly state when verification was not performed.", "rationale": "Never imply successful verification based solely on code inspection."}, {"id": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_rule_precedence", "label": "Rule Precedence", "file_type": "concept", "source_file": "PLMInfrastructureRegisterOrchestratorServiceLayerMSC/CODING-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Conflict resolution order within this file: explicit task requirements, then security/correctness, existing architecture/contracts, feature rules, global rules, style.", "rationale": "Per this repo's root CLAUDE.md, conflicts and ambiguity between the two CODING-RULES.md files, or between either file and anything else, are resolved by asking the user \u2014 which explicitly overrides this section's own precedence ordering."}, {"id": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_agent_assumption_policy", "label": "Agent Assumption Policy", "file_type": "rationale", "source_file": "PLMInfrastructureRegisterOrchestratorServiceLayerMSC/CODING-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Only trivial assumptions not affecting architecture, behavior, security, contracts, data integrity, or dependencies are allowed; material assumptions require asking first.", "rationale": "Per this repo's root CLAUDE.md, this policy's tolerance for trivial assumptions does not get to resolve anything on its own in this repo; the user decides every time a conflict or ambiguity arises."}, {"id": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_scope_discipline", "label": "Scope Discipline", "file_type": "rationale", "source_file": "PLMInfrastructureRegisterOrchestratorServiceLayerMSC/CODING-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Agents must stay within the requested task's scope: no unrelated features, refactors, dependency upgrades, or schema changes without explicit approval.", "rationale": "The objective is to implement the requested change while preserving existing functionality and architecture."}], "edges": [{"source": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_feature_architecture", "target": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_feature_models", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PLMInfrastructureRegisterOrchestratorServiceLayerMSC/CODING-RULES.md", "source_location": null, "weight": 1.0}, {"source": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_feature_architecture", "target": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_assertion_pattern", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PLMInfrastructureRegisterOrchestratorServiceLayerMSC/CODING-RULES.md", "source_location": null, "weight": 1.0}, {"source": "plminfrastructureregisterorchestratorservicelayermsc_coding_rules_feature_architecture", "target": "plminfrastructurereg